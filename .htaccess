
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Let's Encrypt / AutoSSL 
    RewriteRule ^\.well-known/ - [L]

    #  (.env, .git, .env.example…)
    RewriteRule (^|/)\. - [F,L]

    # 
    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|storage|tests|vendor|node_modules)(/|$) - [F,L]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.[jt]s|[^/]+\.md)$ - [F,L]


    # Redirect all requests to public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

