# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────

# Application name: page titles, mail sender name, VITE_APP_NAME. Also the default cache prefix and session cookie name, so changing it logs everyone out.
APP_NAME="cloud-upload-onda"

# [prod] local | production. Use production on the server; phpunit.xml forces testing for the test suite.
APP_ENV=local

# [required][secret][critical] App encryption key; also wraps vault DEKs. Changing it makes every deposit unreadable. Generate once: php artisan key:generate
# Also the fallback secret for passkey user handles; changing it breaks registered passkeys.
APP_KEY=

# [prod] false in production; true only for local debugging.
APP_DEBUG=true

# [required][prod] Base URL of the app (scheme + host, no trailing slash), used for generated links, signed URLs and mail. Use https:// in production.
APP_URL=http://localhost:8000

# ─────────────────────────────────────────────
# Locale
# ─────────────────────────────────────────────

# Last-resort bootstrap locale (ar | fr | en). The languages table decides which locales are active and which is the default.
APP_LOCALE=ar

# Locale used when a translation string is missing in the active locale (ar | fr | en).
APP_FALLBACK_LOCALE=ar

# Locale for fake data generated by factories and seeders (e.g. ar_SA, fr_FR). Dev and tests only.
APP_FAKER_LOCALE=ar_SA

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────

# Log channel from config/logging.php. stack writes to storage/logs/laravel.log through the single channel.
LOG_CHANNEL=stack

# [prod] Minimum level logged: debug | info | notice | warning | error. Use warning or error in production.
LOG_LEVEL=debug

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────

# Database driver: mysql. Tests ignore this and use sqlite :memory: (phpunit.xml).
DB_CONNECTION=mysql

# [prod] Database host. Locally, MySQL runs in WSL2 at 127.0.0.1.
DB_HOST=127.0.0.1

# Database port (MySQL: 3306).
DB_PORT=3306

# [required][prod] Database name.
DB_DATABASE=onda_storage

# [required][prod] Database user.
DB_USERNAME=root

# [secret][prod] Database password. Leave empty in .env.example.
DB_PASSWORD=

# ─────────────────────────────────────────────
# Session
# ─────────────────────────────────────────────

# Session store: database (the sessions table).
SESSION_DRIVER=database

# [prod] Minutes of inactivity before logout.
SESSION_LIFETIME=120

# Session cookie domain. null = the current host only.
SESSION_DOMAIN=null

# [prod] true behind HTTPS (cookie sent over HTTPS only). null = Laravel's default (not forced).
SESSION_SECURE_COOKIE=null

# ─────────────────────────────────────────────
# Cache and Redis
# ─────────────────────────────────────────────

# Cache store: database | redis | file. Must support atomic locks (upload dedup and quota locks).
CACHE_STORE=database

# Redis host. Used only when CHUNK_TRACKER_DRIVER=redis; vault:doctor also pings it (optional).
REDIS_HOST=127.0.0.1

# [secret] Redis password; null = no password. Used only when CHUNK_TRACKER_DRIVER=redis.
REDIS_PASSWORD=null

# Redis port (default 6379; may differ on the server). Used only when CHUNK_TRACKER_DRIVER=redis.
REDIS_PORT=6379

# ─────────────────────────────────────────────
# Queue
# ─────────────────────────────────────────────

# Queue connection: database. Redis must never be a hard dependency. Run php artisan queue:work yourself (Herd does not).
QUEUE_CONNECTION=database

# [critical] Seconds before a running job on the database connection is retried; must stay ≥ 3600; vault:doctor fails below.
DB_QUEUE_RETRY_AFTER=3600

# ─────────────────────────────────────────────
# Mail
# ─────────────────────────────────────────────

# [prod] Mail transport: log (writes mail to the log) | smtp. Use smtp in production.
MAIL_MAILER=log

# [prod] SMTP host.
MAIL_HOST=127.0.0.1

# [prod] SMTP port (587 = STARTTLS, 465 = TLS, 2525 = dev mail catchers).
MAIL_PORT=2525

# [prod] SMTP user; null = no authentication.
MAIL_USERNAME=null

# [secret][prod] SMTP password; null = no authentication.
MAIL_PASSWORD=null

# [prod] Sender address of every outgoing mail.
MAIL_FROM_ADDRESS="hello@example.com"

# Sender name of every outgoing mail.
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────
# Filesystems
# ─────────────────────────────────────────────

# [required][critical] Root of the vault disk (encrypted deposits and .mac sidecars). Absolute path outside the project; all four roots on one partition; use / even on Windows.
VAULT_DISK_ROOT=C:/onda-storage/vault

# [required] Root of the incoming disk (pre-allocated, encrypted upload files being assembled). Same partition as VAULT_DISK_ROOT.
INCOMING_DISK_ROOT=C:/onda-storage/incoming

# [required] Root of the work disk (short-lived decrypted temp files for the pipeline). Same partition as VAULT_DISK_ROOT.
WORK_DISK_ROOT=C:/onda-storage/work

# [required] Root of the variants disk (encrypted posters, preview clips, consultation assets). Same partition as VAULT_DISK_ROOT.
VARIANTS_DISK_ROOT=C:/onda-storage/variants

# ─────────────────────────────────────────────
# Vault
# ─────────────────────────────────────────────

# [required][critical] Absolute path to the 32-byte vault master key, outside the web root. Use forward slashes, even on Windows (D:/onda-secrets/vault-master.key).
# Never inside the repo, storage/ or a backup set. Losing the file makes every deposit unreadable.
VAULT_MASTER_KEY_PATH=C:/onda-secrets/vault-master.key

# Maximum size of one uploaded file, in bytes (5368709120 = 5 GiB).
VAULT_MAX_FILE_SIZE=5368709120

# Days a soft-deleted file keeps its bytes before the purge job frees them (the purge job is not built yet).
VAULT_RETENTION_DAYS=30

# Minutes an upload session and its temp files live before they expire.
VAULT_TEMP_TTL_MINUTES=120

# Seconds the dedup and quota-ledger locks are held.
VAULT_DEDUP_LOCK_SECONDS=10

# [prod] Full-download delivery: stream (local) | litespeed (cPanel). Full download is not implemented yet; both behave the same.
DELIVERY_DRIVER=stream

# [prod] Malware scanner: null (no scan, local) | clamav (clamdscan; set only where ClamAV is installed).
SCAN_DRIVER=null

# [prod] Upload chunk tracker: database | redis. redis needs REDIS_* reachable.
CHUNK_TRACKER_DRIVER=database

# [prod] Media metadata probe: ffmpeg (runs FFPROBE_BINARY) | null (no duration/size metadata). Use null where ffprobe is absent.
MEDIA_PROBE_DRIVER=ffmpeg

# ─────────────────────────────────────────────
# Upload
# ─────────────────────────────────────────────

# [prod] Chunk requests in flight across all files in one browser; keep below the PHP worker count.
VAULT_CLIENT_MAX_IN_FLIGHT=3

# [prod] Chunk requests in flight for one file; keep below the PHP worker count.
VAULT_CLIENT_PER_FILE_IN_FLIGHT=2

# ─────────────────────────────────────────────
# Consultation / preview
# ─────────────────────────────────────────────

# ffmpeg: video poster, 30 s preview clip and audio waveform (GenerateVariants), and admin preview watermark. Not installed on cPanel production.
# If missing: each variant is logged and skipped, the deposit still completes. Name on PATH or absolute path with /.
FFMPEG_BINARY=ffmpeg

# ffprobe: duration and dimensions when MEDIA_PROBE_DRIVER=ffmpeg. Not installed on cPanel production.
# If missing: a warning is logged and metadata stays null; the deposit still completes. Name on PATH or absolute path with /.
FFPROBE_BINARY=ffprobe

# pdftoppm: rasterises PDF pages, only for a family set to derivative (today PDFs use the browser-native PDF.js viewer). Not installed on cPanel production.
# If missing: falls back to the imagick extension, else the file shows a "preview unavailable" card (tool_missing:pdftoppm).
PDFTOPPM_BINARY=pdftoppm

# soffice (LibreOffice): converts office files to PDF, only for a family set to derivative (today docx is browser-native, doc/odt/ppt/odp unsupported). Not installed on cPanel production.
# If missing: the file shows a "preview unavailable" card (tool_missing:soffice). An absolute path that does not exist also counts as missing.
SOFFICE_BINARY=soffice

# clamdscan: used only when SCAN_DRIVER=clamav. Not installed on cPanel production.
# If missing with SCAN_DRIVER=clamav: the scan job throws, is retried once, then the deposit is marked failed. Unused when SCAN_DRIVER=null.
CLAMDSCAN_BINARY=clamdscan

# Seconds before ffprobe is killed (metadata then stays null).
VAULT_PROBE_TIMEOUT=30

# Seconds before clamdscan is killed (counts as a scan error, not a verdict).
VAULT_SCAN_TIMEOUT=120

# Seconds before one ffmpeg variant run is killed (that variant is skipped).
VAULT_VARIANT_TIMEOUT=300

# Position of the video poster frame, as a fraction of the duration (0.10 = 10%).
VAULT_POSTER_FRAME_PERCENT=0.10

# Length of the video preview clip, in seconds.
VAULT_PREVIEW_MAX_SECONDS=30

# Maximum height of the video preview clip, in pixels.
VAULT_PREVIEW_MAX_HEIGHT=480

# ─────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────

# App name exposed to the browser bundle (import.meta.env.VITE_APP_NAME); read at build time.
VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────
# Local tooling
# ─────────────────────────────────────────────

# IP that vault:doctor --fpm resolves the app domain to (for a server behind NAT). Empty = normal DNS.
VAULT_DOCTOR_RESOLVE_IP=
