APP_NAME="cloud-upload-onda"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file


BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=onda_storage
DB_USERNAME=root
DB_PASSWORD=admin123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ONDA Vault — storage disks (all four MUST share one partition; rename() on
# upload complete() is only instant because of this).
VAULT_DISK_ROOT=C:/onda-storage/vault
INCOMING_DISK_ROOT=C:/onda-storage/incoming
WORK_DISK_ROOT=C:/onda-storage/work
VARIANTS_DISK_ROOT=C:/onda-storage/variants

# ONDA Vault — master key (KEK) that wraps every per-file DEK.
# WARNING: losing this file makes every encrypted file permanently
# unrecoverable. It MUST live outside the repo and outside every backup set.
VAULT_MASTER_KEY_PATH=C:/onda-secrets/vault-master.key

VAULT_CHUNK_SIZE=8388608
VAULT_MAX_FILE_SIZE=5368709120
VAULT_MAC_SEGMENT_SIZE=1048576
VAULT_RETENTION_DAYS=30
VAULT_TEMP_TTL_MINUTES=120

DELIVERY_DRIVER=stream
SCAN_DRIVER=null
CHUNK_TRACKER_DRIVER=database
MEDIA_PROBE_DRIVER=ffmpeg

# winget-installed ffmpeg isn't on this shell's PATH without reopening the
# terminal — absolute paths make it work for the queue worker regardless.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
CLAMDSCAN_BINARY=clamdscan
VAULT_PROBE_TIMEOUT=30
VAULT_SCAN_TIMEOUT=120
VAULT_VARIANT_TIMEOUT=300
VAULT_DEDUP_LOCK_SECONDS=10
VAULT_POSTER_FRAME_PERCENT=0.10
VAULT_PREVIEW_MAX_SECONDS=30
VAULT_PREVIEW_MAX_HEIGHT=480
